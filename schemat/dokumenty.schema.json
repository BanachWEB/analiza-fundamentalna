    "TypDokumentu": {
      "enum": [
        "sec_api",
        "10-K",
        "10-Q",
        "8-K",
        "20-F",
        "6-K",
        "esef",
        "raport_pdf",
        "espi",
        "strona",
        "wklejka",
        "inny"
