          "title": "Adres"
        },
        "opis": {
          "default": "",
          "title": "Opis",
          "type": "string"
        },
        "pobrano": {
          "format": "date-time",
          "title": "Pobrano",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "plik": {
          "description": "Nazwa pliku w archiwum (poza repozytorium)",
          "title": "Plik",
          "type": "string"
        }
      },
      "required": [
        "id",
        "typ",
        "zrodlo",
        "pobrano",
        "sha256",
        "plik"
      ],
      "title": "Dokument",
      "type": "object"
